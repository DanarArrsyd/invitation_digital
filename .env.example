# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile — verifies public RSVP/wishes submissions.
# Get production keys from https://dash.cloudflare.com/?to=/:account/turnstile
# (one widget per domain). For local dev you can use Cloudflare's published
# "always passes" test keys instead — see
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Absolute origin used for metadata, share cards and copied guest links.
# Optional locally; set to the production domain on Vercel.
NEXT_PUBLIC_SITE_URL=
